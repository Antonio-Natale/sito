---
import { getMateria } from '@/data/site';
import { coloreMateria } from '@/lib/colori';
import { withBase } from '@/lib/utils';

interface Props {
  title: string;
  href: string;
  description?: string;
  meta?: string;
  badge?: string;
  /** slug della materia: mostra un'etichetta colorata */
  materia?: string;
  /** attributi data-* usati dai filtri (es. { 'data-materia': 'storia' }) */
  dataAttrs?: Record<string, string>;
}

const { title, href, description, meta, badge, materia, dataAttrs = {} } = Astro.props;
const m = materia ? getMateria(materia) : undefined;
const colore = materia ? coloreMateria(materia) : undefined;
---

<a
  href={withBase(href)}
  {...dataAttrs}
  class:list={[
    'group block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700',
    colore && ['border-l-4', colore.bordo]
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
      {title}
    </h3>
    {
      badge && (
        <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          {badge}
        </span>
      )
    }
  </div>
  {
    /* nelle card solo le prime righe: il testo completo è nella pagina del materiale */
    description && <p class="mt-2 line-clamp-3 text-sm text-slate-600 dark:text-slate-400" title={description}>{description}</p>
  }
  {
    (m || meta) && (
      <p class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        {m && colore && <span class:list={['rounded-full px-2 py-0.5 font-medium', colore.chip]}>{m.nome}</span>}
        {meta && <span>{meta}</span>}
      </p>
    )
  }
</a>
