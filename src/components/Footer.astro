---
import { SITE, SOCIAL } from '@/data/site';
import { withBase } from '@/lib/utils';

const anno = new Date().getFullYear();
---

<footer class="no-print border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
  <div
    class="mx-auto flex max-w-4xl flex-col gap-3 px-4 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-slate-400"
  >
    <p>{SITE.nome} · {SITE.istituto}</p>
    <ul class="flex flex-wrap gap-4">
      <li><a href={`mailto:${SITE.email}`} class="hover:text-brand-700 dark:hover:text-brand-300">{SITE.email}</a></li>
      {
        SOCIAL.map((s) => (
          <li>
            <a href={s.href} class="hover:text-brand-700 dark:hover:text-brand-300" rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a href={withBase('/rss.xml')} class="hover:text-brand-700 dark:hover:text-brand-300">RSS</a></li>
    </ul>
  </div>
  <div class="mx-auto max-w-4xl px-4 pb-8 sm:px-6">
    <p class="border-t border-slate-200 pt-4 text-xs leading-relaxed text-slate-500 dark:border-slate-800 dark:text-slate-400">
      Sito personale, non istituzionale.<br />
      © {anno} {SITE.nome}. I materiali sono consultabili liberamente su questo sito: è possibile condividerne il link e
      utilizzarli direttamente dalle sue pagine. Non ne è consentita la copia, la riproduzione o la distribuzione senza
      autorizzazione.
    </p>
  </div>
</footer>
