---
import { NAV, SITE } from '@/data/site';
import { withBase } from '@/lib/utils';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? path === full : path.startsWith(full);
};
---

<header class="no-print border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={withBase('/')} class="font-semibold text-slate-900 hover:text-brand-700 dark:text-white dark:hover:text-brand-300">
      {SITE.titolo}
    </a>

    <!-- Menu desktop -->
    <nav aria-label="Navigazione principale" class="hidden md:block">
      <ul class="flex gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'bg-brand-50 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Menu mobile (senza JavaScript) -->
    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Menu
      </summary>
      <ul
        class="absolute right-0 z-10 mt-2 w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"
      >
        {
          NAV.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm',
                  isActive(item.href)
                    ? 'bg-brand-50 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200'
                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>
