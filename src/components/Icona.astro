} as const;

export type NomeIcona = keyof typeof PERCORSI;

interface Props {
  nome: NomeIcona;
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}

const { nome, class: classe = 'h-4 w-4', ...resto } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', classe]}
  {...resto}
>
  {PERCORSI[nome].map((d) => <path d={d} />)}
</svg>
