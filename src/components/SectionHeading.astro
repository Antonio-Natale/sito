---
import { withBase } from '@/lib/utils';

interface Props {
  title: string;
  id?: string;
  link?: { label: string; href: string };
}

const { title, id, link } = Astro.props;
---

<div class="mb-4 flex items-baseline justify-between gap-4">
  <h2 id={id} class="scroll-mt-6 text-xl font-bold text-slate-900 dark:text-white">{title}</h2>
  {
    link && (
      <a href={withBase(link.href)} class="no-print text-sm text-brand-600 hover:underline dark:text-brand-300">
        {link.label} →
      </a>
    )
  }
</div>
