---
// Layout per le pagine di dettaglio (materiale, progetto).
import BaseLayout from './BaseLayout.astro';
import { withBase } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  back: { label: string; href: string };
  meta?: string[];
  tags?: string[];
}

const { title, description, back, meta = [], tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <a href={withBase(back.href)} class="no-print text-sm text-brand-600 hover:underline dark:text-brand-300">← {back.label}</a>

  <header class="mt-4 border-b border-slate-200 pb-6 dark:border-slate-800">
    <slot name="sopra-titolo" />
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{title}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{description}</p>
    {meta.length > 0 && <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{meta.join(' · ')}</p>}
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/50 dark:text-brand-200">
              {t}
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <slot name="prima" />

  <article class="prose mt-8 max-w-none">
    <slot />
  </article>

  <slot name="dopo" />
</BaseLayout>
