---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Card from '@/components/Card.astro';
import Icona from '@/components/Icona.astro';
import VisualizzatorePdf from '@/components/VisualizzatorePdf.astro';
import { getMateria } from '@/data/site';
import { coloreMateria } from '@/lib/colori';
import { confrontaMateriali, materialiVicini } from '@/lib/materiali';
import { ETICHETTE_TIPO, formatClassi, formatDate, getPublished, slugify, withBase } from '@/lib/utils';

export const getStaticPaths = (async () => {
  const materiali = await getPublished('materiali');
  return materiali.map((entry) => {
    // tutti i materiali dello stesso argomento, compreso questo, nell'ordine del sito
    const gruppo = materiali
      .filter((m) => m.data.materia === entry.data.materia && m.data.argomento === entry.data.argomento)
      .sort(confrontaMateriali);
    const indice = gruppo.findIndex((m) => m.id === entry.id);
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        correlati: materialiVicini(gruppo, indice),
        totaleArgomento: gruppo.length,
        precedente: gruppo[indice - 1],
        successivo: gruppo[indice + 1]
      }
    };
  });
}) satisfies GetStaticPaths;

type Materiale = CollectionEntry<'materiali'>;

interface Props {
  entry: Materiale;
  correlati: Materiale[];
  totaleArgomento: number;
  precedente?: Materiale;
  successivo?: Materiale;
}

const { entry, correlati, totaleArgomento, precedente, successivo } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const materia = getMateria(d.materia)!;

const isPdf = (f: string) => f.toLowerCase().endsWith('.pdf');
const pdfIncorporati = d.allegati.filter((a) => !a.scaricabile && isPdf(a.file));
const link = d.allegati.filter((a) => a.scaricabile || !isPdf(a.file));

const meta = [
  d.argomento,
  ETICHETTE_TIPO[d.tipo],
  d.classi.length ? `classi ${formatClassi(d.classi)}` : '',
  formatDate(d.data)
].filter(Boolean);
---

<EntryLayout
  title={d.title}
  description={d.description}
  back={{ label: materia.nome, href: `/didattica/materia/${materia.slug}/` }}
  meta={meta}
  tags={d.tags}
>
  <a
    slot="sopra-titolo"
    href={withBase(`/didattica/materia/${materia.slug}/`)}
    class:list={['mb-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium', coloreMateria(materia.slug).chip]}
  >
    {materia.nome}
  </a>

  {
    link.length > 0 && (
      <aside slot="prima" class="mt-6 rounded-xl border border-brand-100 bg-brand-50/50 p-5 dark:border-brand-900 dark:bg-brand-950/40">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300">Risorse</h2>
        <ul class="mt-3 space-y-2">
          {link.map((a) => (
            <li>
              {a.scaricabile ? (
                <a href={withBase(a.file)} class="inline-flex items-center gap-2 font-medium text-brand-700 hover:underline dark:text-brand-300" download>
                  <Icona nome="scarica" />
                  {a.nome}
                </a>
              ) : (
                <a href={withBase(a.file)} class="inline-flex items-center gap-2 font-medium text-brand-700 hover:underline dark:text-brand-300" target="_blank" rel="noopener">
                  <Icona nome="apri" />
                  {a.nome}
                </a>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    d.slides && (
      <section slot="prima" class="mt-8 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
        <iframe src={withBase(d.slides)} title={`Slide: ${d.title}`} class="aspect-video w-full bg-white" allowfullscreen loading="lazy" />
      </section>
    )
  }

  {pdfIncorporati.map((a) => <VisualizzatorePdf slot="prima" file={a.file} nome={a.nome} />)}

  <Content />

  {
    (precedente || successivo) && (
      <nav slot="dopo" aria-label={`Materiali su «${d.argomento}»`} class="no-print mt-14 grid gap-4 sm:grid-cols-2">
        {precedente && (
          <a
            href={withBase(`/didattica/${precedente.slug}/`)}
            rel="prev"
            class="group block rounded-xl border border-slate-200 bg-white p-4 transition hover:border-brand-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700"
          >
            <span class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">← Precedente</span>
            <span class="mt-1 block font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
              {precedente.data.title}
            </span>
          </a>
        )}
        {successivo && (
          <a
            href={withBase(`/didattica/${successivo.slug}/`)}
            rel="next"
            class="group block rounded-xl border border-slate-200 bg-white p-4 text-right transition hover:border-brand-300 hover:shadow-md sm:col-start-2 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700"
          >
            <span class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Successivo →</span>
            <span class="mt-1 block font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
              {successivo.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }

  {
    correlati.length > 0 && (
      <section
        slot="dopo"
        class:list={[
          'no-print border-t border-slate-200 pt-8 dark:border-slate-800',
          precedente || successivo ? 'mt-10' : 'mt-14'
        ]}
      >
        <h2 class="mb-4 text-lg font-bold text-slate-900 dark:text-white">Altri materiali su «{d.argomento}»</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {correlati.map((m) => (
            <Card
              title={m.data.title}
              href={`/didattica/${m.slug}/`}
              description={m.data.description}
              badge={ETICHETTE_TIPO[m.data.tipo]}
            />
          ))}
        </div>
        {totaleArgomento - 1 > correlati.length && (
          <p class="mt-4 text-right">
            <a
              href={withBase(`/didattica/materia/${materia.slug}/#${slugify(d.argomento)}`)}
              class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300"
            >
              Vedi tutti i {totaleArgomento} materiali su «{d.argomento}» →
            </a>
          </p>
        )}
      </section>
    )
  }
</EntryLayout>
