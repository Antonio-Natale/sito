---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Card from '@/components/Card.astro';
import VisualizzatorePdf from '@/components/VisualizzatorePdf.astro';
import { getMateria } from '@/data/site';
import { coloreMateria } from '@/lib/colori';
import { confrontaMateriali } from '@/lib/materiali';
import { ETICHETTE_TIPO, formatClassi, formatDate, getPublished, withBase } from '@/lib/utils';

export const getStaticPaths = (async () => {
  const materiali = await getPublished('materiali');
  return materiali.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      correlati: materiali
        .filter(
          (m) => m.id !== entry.id && m.data.materia === entry.data.materia && m.data.argomento === entry.data.argomento
        )
        .sort(confrontaMateriali)
        .slice(0, 4)
    }
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'materiali'>;
  correlati: CollectionEntry<'materiali'>[];
}

const { entry, correlati } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const materia = getMateria(d.materia)!;

const isPdf = (f: string) => f.toLowerCase().endsWith('.pdf');
const pdfIncorporati = d.allegati.filter((a) => !a.scaricabile && isPdf(a.file));
const link = d.allegati.filter((a) => a.scaricabile || !isPdf(a.file));

const meta = [
  d.argomento,
  ETICHETTE_TIPO[d.tipo],
  d.classi.length ? `classi ${formatClassi(d.classi)}` : '',
  formatDate(d.data)
].filter(Boolean);
---

<EntryLayout
  title={d.title}
  description={d.description}
  back={{ label: materia.nome, href: `/didattica/materia/${materia.slug}/` }}
  meta={meta}
  tags={d.tags}
>
  <a
    slot="sopra-titolo"
    href={withBase(`/didattica/materia/${materia.slug}/`)}
    class:list={['mb-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium', coloreMateria(materia.slug).chip]}
  >
    {materia.nome}
  </a>

  {
    link.length > 0 && (
      <aside slot="prima" class="mt-6 rounded-xl border border-brand-100 bg-brand-50/50 p-5 dark:border-brand-900 dark:bg-brand-950/40">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-300">Risorse</h2>
        <ul class="mt-3 space-y-2">
          {link.map((a) => (
            <li>
              {a.scaricabile ? (
                <a href={withBase(a.file)} class="font-medium text-brand-700 hover:underline dark:text-brand-300" download>
                  ⤓ {a.nome}
                </a>
              ) : (
                <a href={withBase(a.file)} class="font-medium text-brand-700 hover:underline dark:text-brand-300" target="_blank" rel="noopener">
                  ▸ {a.nome}
                </a>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    d.slides && (
      <section slot="prima" class="mt-8 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
        <iframe src={withBase(d.slides)} title={`Slide: ${d.title}`} class="aspect-video w-full bg-white" allowfullscreen loading="lazy" />
      </section>
    )
  }

  {pdfIncorporati.map((a) => <VisualizzatorePdf slot="prima" file={a.file} nome={a.nome} />)}

  <Content />

  {
    correlati.length > 0 && (
      <section slot="dopo" class="no-print mt-14 border-t border-slate-200 pt-8 dark:border-slate-800">
        <h2 class="mb-4 text-lg font-bold text-slate-900 dark:text-white">Altri materiali su «{d.argomento}»</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {correlati.map((m) => (
            <Card
              title={m.data.title}
              href={`/didattica/${m.slug}/`}
              description={m.data.description}
              badge={ETICHETTE_TIPO[m.data.tipo]}
            />
          ))}
        </div>
      </section>
    )
  }
</EntryLayout>
