---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import Filtri from '@/components/Filtri.astro';
import { coloreMateria } from '@/lib/colori';
import { attributiFiltro, opzioniFiltri, perMateria } from '@/lib/materiali';
import { ETICHETTE_TIPO, formatClassi, formatDate, getPublished, slugify, withBase } from '@/lib/utils';

const materiali = await getPublished('materiali');
const gruppi = perMateria(materiali);
const { argomenti, tipi } = opzioniFiltri(materiali);
---

<BaseLayout title="Didattica" description="Dispense, slide, esercizi, mappe e materiali divisi per materia e argomento.">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Didattica</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">
    Materiali divisi per materia e argomento. Usa i filtri per trovare subito quello che ti serve.
  </p>

  {
    gruppi.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {gruppi.map(({ materia }) => (
          <li>
            <a
              href={withBase(`/didattica/materia/${materia.slug}/`)}
              class:list={['inline-block rounded-full px-3 py-1 text-sm font-medium hover:opacity-80', coloreMateria(materia.slug).chip]}
            >
              {materia.nome}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {materiali.length > 0 && <Filtri argomenti={argomenti} tipi={tipi} />}
  {materiali.length === 0 && <p class="mt-8 text-slate-500 dark:text-slate-400">Nessun materiale pubblicato.</p>}

  {
    gruppi.map(({ materia, argomenti }) => (
      <section data-gruppo class="mt-12">
        <div class="mb-2 flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{materia.nome}</h2>
          <a href={withBase(`/didattica/materia/${materia.slug}/`)} class="text-sm text-brand-600 hover:underline dark:text-brand-300">
            Pagina della materia →
          </a>
        </div>
        {argomenti.map(([argomento, lista]) => (
          <div data-gruppo class="mt-6" id={`${materia.slug}-${slugify(argomento)}`}>
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{argomento}</h3>
            <div class="grid gap-4 sm:grid-cols-2">
              {lista.map((m) => (
                <Card
                  title={m.data.title}
                  href={`/didattica/${m.slug}/`}
                  description={m.data.description}
                  meta={[formatDate(m.data.data), m.data.classi.length ? `classi ${formatClassi(m.data.classi)}` : '']
                    .filter(Boolean)
                    .join(' · ')}
                  badge={ETICHETTE_TIPO[m.data.tipo]}
                  materia={m.data.materia}
                  dataAttrs={attributiFiltro(m)}
                />
              ))}
            </div>
          </div>
        ))}
      </section>
    ))
  }
</BaseLayout>
