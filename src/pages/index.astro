---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { MATERIE, MOSTRA_PROGETTI, SITE } from '@/data/site';
import { coloreMateria } from '@/lib/colori';
import { ETICHETTE_TIPO, byDateDesc, formatDate, getPublished, withBase } from '@/lib/utils';

const tuttiMateriali = await getPublished('materiali');
const materiali = [...tuttiMateriali].sort(byDateDesc).slice(0, 4);
const progetti = (MOSTRA_PROGETTI ? await getPublished('progetti') : [])
  .sort((a, b) => Number(b.data.inEvidenza) - Number(a.data.inEvidenza) || byDateDesc(a, b))
  .slice(0, 2);

const conteggio = (slug: string) => tuttiMateriali.filter((m) => m.data.materia === slug).length;
---

<BaseLayout>
  <section class="py-8">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-600 dark:text-brand-300">{SITE.istituto}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">{SITE.titolo}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{SITE.descrizione}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={withBase('/didattica/')} class="rounded-lg bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">
        Materiali didattici
      </a>
      <a
        href={withBase('/curriculum/')}
        class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Curriculum
      </a>
      <a
        href={withBase('/ricevimento/')}
        class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Ricevimento
      </a>
    </div>
  </section>

  <section class="mt-8">
    <SectionHeading title="Le mie materie" />
    <div class="grid gap-4 sm:grid-cols-2">
      {
        MATERIE.map((m) => (
          <a
            href={withBase(`/didattica/materia/${m.slug}/`)}
            class:list={[
              'group block rounded-xl border border-l-4 border-slate-200 bg-white p-5 transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900',
              coloreMateria(m.slug).bordo
            ]}
          >
            <h3 class="text-lg font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
              {m.nome}
            </h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{m.descrizione}</p>
            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              {conteggio(m.slug)} {conteggio(m.slug) === 1 ? 'materiale' : 'materiali'}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <SectionHeading title="Ultimi materiali" link={{ label: 'Tutti i materiali', href: '/didattica/' }} />
    {
      materiali.length === 0 ? (
        <p class="text-slate-500 dark:text-slate-400">Nessun materiale pubblicato.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {materiali.map((m) => (
            <Card
              title={m.data.title}
              href={`/didattica/${m.slug}/`}
              description={m.data.description}
              meta={`${m.data.argomento} · ${formatDate(m.data.data)}`}
              badge={ETICHETTE_TIPO[m.data.tipo]}
              materia={m.data.materia}
            />
          ))}
        </div>
      )
    }
  </section>

  {
    progetti.length > 0 && (
      <section class="mt-12">
        <SectionHeading title="Progetti" link={{ label: 'Tutti i progetti', href: '/progetti/' }} />
        <div class="grid gap-4 sm:grid-cols-2">
          {progetti.map((p) => (
            <Card
              title={p.data.title}
              href={`/progetti/${p.slug}/`}
              description={p.data.description}
              meta={p.data.annoScolastico ? `a.s. ${p.data.annoScolastico}` : undefined}
              badge={p.data.tipo}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
