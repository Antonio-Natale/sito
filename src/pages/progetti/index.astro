---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { MOSTRA_PROGETTI } from '@/data/site';
import { byDateDesc, getPublished, metaProgetto, withBase } from '@/lib/utils';

// Sezione nascosta: chi apre /progetti/ viene rimandato alla home.
if (!MOSTRA_PROGETTI) return Astro.redirect(withBase('/'));

// In ogni sezione: prima i progetti in corso, poi i conclusi; a parità, i più recenti.
const progetti = (await getPublished('progetti')).sort(
  (a, b) => Number(a.data.stato === 'concluso') - Number(b.data.stato === 'concluso') || byDateDesc(a, b)
);

const sezioni = [
  {
    titolo: 'Progetti scolastici',
    intro: 'PCTO, progetti del PTOF, Erasmus+, olimpiadi e uscite didattiche.',
    lista: progetti.filter((p) => p.data.ambito === 'scolastico')
  },
  {
    titolo: 'Progetti personali',
    intro: 'Applicazioni, siti web e strumenti didattici che ho sviluppato.',
    lista: progetti.filter((p) => p.data.ambito === 'personale')
  }
].filter((s) => s.lista.length > 0);
---

<BaseLayout title="Progetti" description="Progetti scolastici e progetti personali di sviluppo software.">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Progetti</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">Progetti realizzati a scuola con le classi e progetti personali di sviluppo.</p>

  {
    sezioni.length === 0 && (
      <div class="mt-10 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center dark:border-slate-700 dark:bg-slate-900">
        <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 dark:bg-brand-900 dark:text-brand-200">
          In arrivo
        </span>
        <h2 class="mt-4 text-xl font-bold text-slate-900 dark:text-white">Sezione in preparazione</h2>
        <p class="mx-auto mt-2 max-w-md text-slate-600 dark:text-slate-400">
          A breve saranno pubblicati i progetti realizzati a scuola con le classi e i progetti personali di sviluppo.
        </p>
      </div>
    )
  }

  {
    sezioni.map((s) => (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">{s.titolo}</h2>
        <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">{s.intro}</p>
        <div class="grid gap-4 sm:grid-cols-2">
          {s.lista.map((p) => (
            <Card
              title={p.data.title}
              href={`/progetti/${p.slug}/`}
              description={p.data.description}
              meta={metaProgetto(p.data)}
              badge={p.data.tipo}
            />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
