---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { byDateDesc, getPublished } from '@/lib/utils';

const progetti = (await getPublished('progetti')).sort(byDateDesc);

const gruppi = [
  { titolo: 'In corso', lista: progetti.filter((p) => p.data.stato === 'in corso') },
  { titolo: 'Conclusi', lista: progetti.filter((p) => p.data.stato === 'concluso') }
].filter((g) => g.lista.length > 0);
---

<BaseLayout title="Progetti" description="PCTO, progetti PTOF, Erasmus+, olimpiadi e uscite didattiche.">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Progetti</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">PCTO, progetti del PTOF, Erasmus+, olimpiadi e uscite didattiche.</p>

  {gruppi.length === 0 && <p class="mt-8 text-slate-500 dark:text-slate-400">Nessun progetto pubblicato.</p>}

  {
    gruppi.map((g) => (
      <section class="mt-10">
        <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">{g.titolo}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {g.lista.map((p) => (
            <Card
              title={p.data.title}
              href={`/progetti/${p.slug}/`}
              description={p.data.description}
              meta={p.data.annoScolastico ? `a.s. ${p.data.annoScolastico}` : undefined}
              badge={p.data.tipo}
            />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
