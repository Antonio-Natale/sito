---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RICEVIMENTO, SITE } from '@/data/site';
---

<BaseLayout title="Ricevimento e contatti" description="Orari di ricevimento, prenotazione dei colloqui e contatti.">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Ricevimento e contatti</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">Orari dei colloqui con le famiglie e modalità di contatto.</p>

  <section class="mt-10">
    <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-white">Orario di ricevimento</h2>
    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600 dark:bg-slate-900 dark:text-slate-400">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold">Giorno</th>
            <th scope="col" class="px-4 py-3 font-semibold">Orario</th>
            <th scope="col" class="px-4 py-3 font-semibold">Note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
          {
            RICEVIMENTO.orari.map((o) => (
              <tr>
                <td class="px-4 py-3 font-medium text-slate-900 dark:text-slate-100">{o.giorno}</td>
                <td class="px-4 py-3 tabular-nums">{o.ora}</td>
                <td class="px-4 py-3 text-slate-600 dark:text-slate-400">{o.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {RICEVIMENTO.note && <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{RICEVIMENTO.note}</p>}
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-xl font-bold text-slate-900 dark:text-white">Come prenotare</h2>
    <p class="text-slate-700 dark:text-slate-300">{RICEVIMENTO.prenotazione}</p>
    <a
      href={RICEVIMENTO.linkRegistro}
      target="_blank"
      rel="noopener"
      class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700"
    >
      Vai al registro elettronico ↗
    </a>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-xl font-bold text-slate-900 dark:text-white">Contatti</h2>
    <p class="text-slate-700 dark:text-slate-300">
      Email: <a href={`mailto:${SITE.email}`} class="text-brand-600 hover:underline dark:text-brand-300">{SITE.email}</a>
    </p>
  </section>
</BaseLayout>
